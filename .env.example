# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Security
JWT_SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_PATH=climate_system.db

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://

# Sensor Thresholds
TEMP_MIN=18.0
TEMP_MAX=26.0
HUMIDITY_MIN=30.0
HUMIDITY_MAX=60.0
CO2_CRITICAL=1000
CO2_DANGER=1500
